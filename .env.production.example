# Salin ke .env di server hosting, lalu isi sesuai data hosting Anda.
APP_NAME="School Class Progress"
APP_ENV=production
APP_KEY=                      # isi dengan: php artisan key:generate --show
APP_DEBUG=false               # WAJIB false di server publik
APP_URL=https://scp.namadomain.com
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost             # umumnya localhost di shared hosting
DB_PORT=3306
DB_DATABASE=nama_database_hosting
DB_USERNAME=user_database_hosting
DB_PASSWORD=password_database_hosting

# Email untuk kode reset password (contoh Gmail: aktifkan verifikasi 2 langkah, buat "Sandi aplikasi")
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=emailsekolah@gmail.com
MAIL_PASSWORD=sandi_aplikasi_16_karakter
MAIL_SCHEME=smtp
MAIL_FROM_ADDRESS=emailsekolah@gmail.com
MAIL_FROM_NAME="School Class Progress"

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
